
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:label="Saqib Pool Pro">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".AimCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
<service
    android:name=".AimCaptureService"
    android:exported="false"
    android:foregroundServiceType="mediaProjection" />

<service
    android:name=".AimOverlayService"
    android:exported="false" />
Intent overlay = new Intent(
        this, AimOverlayService.class);

startService(overlay);

Intent capture = new Intent(
        this, AimCaptureService.class);

capture.putExtra(
        AimCaptureService.EXTRA_RESULT_CODE,
        resultCode);

capture.putExtra(
        AimCaptureService.EXTRA_DATA,
        data);

if (Build.VERSION.SDK_INT >= 26) {
    startForegroundService(capture);
} else {
    startService(capture);
}
