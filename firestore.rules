rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can access only their own app data and metadata.
    match /users/{userId}/{collection}/{documentId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && collection in ['expenses', 'incomes', 'reminders', 'categoryItems', 'adminStats'];
    }

    // The designated admin can read account summaries only, never financial record contents.
    match /{path=**}/adminStats/{documentId} {
      allow read: if request.auth != null
                  && request.auth.token.email == 'saqibbukhari2917@gmail.com';
    }
  }
}
